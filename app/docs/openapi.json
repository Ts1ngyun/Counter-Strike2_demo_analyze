  "components": {
    "schemas": {
      "Annotation": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Evidence Id"
          },
          "label": {
            "type": "string",
            "enum": [
              "unreviewed",
              "problem",
              "reasonable",
              "uncertain"
            ],
            "title": "Label",
            "default": "unreviewed"
          },
          "note": {
            "type": "string",
            "maxLength": 4000,
            "title": "Note",
            "default": ""
          },
          "starred": {
            "type": "boolean",
            "title": "Starred",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "evidence_id"
        ],
        "title": "Annotation"
      },
      "Body_upload_api_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "config": {
            "type": "string",
            "title": "Config",
            "default": "{}"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_upload_post"
      },
      "Bookmark": {
        "properties": {
          "round_id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Round Id"
          },
          "tick": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tick"
          },
          "end_tick": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "End Tick"
          },
          "player_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Player Id"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "title": "Title",
            "default": ""
          },
          "note": {
            "type": "string",
            "maxLength": 4000,
            "title": "Note",
            "default": ""
          },
          "lines": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/Point"
              },
              "type": "array"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Lines"
          }
        },
        "type": "object",
        "required": [
          "round_id",
          "tick"
        ],
        "title": "Bookmark"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Point": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Point"
      },
      "ProfileInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ProfileInput"
      },
      "SaveInput": {
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Job Id"
          },
          "player_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 1,
            "title": "Player Ids"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "player_ids"
        ],
        "title": "SaveInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VisibilityInput": {
        "properties": {
          "hidden": {
            "type": "boolean",
            "title": "Hidden"
          }
        },
        "type": "object",
        "required": [
          "hidden"
        ],
        "title": "VisibilityInput"
      }
    }
  }
}
